.switch {
    position: relative;
    display: inline-block;
    width: 56px;
    height:30px ;   
}
.switch input {
    display: none;
}
.slider {
    position: absolute;
    inset: 0;
    background: #e0e5ec;
    border-radius: 32px;
    box-shadow: inset 3px 3px 6px #c8ccd1;
    inset: -3px -3px 6px #ffffff;
    cursor: pointer;
    transition: transition 0.3s;
}
.slider::before {
    content: "";
    position: absolute;
    width: 24px;
    height: 24px;
    top: 4px;
    left: 4px;
    border-radius: 50%;
    background: #e0e5ec;
    box-shadow: 3px 3px 6px #b8bcc2,
    -3px -3px 6px #ffffff;
    transition: 0.3s;
}
switch input:checked + .slider {
    background: #4caf50;
}
switch input :checked + .slider::before {
    transform: translate(26px);
}